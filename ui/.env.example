# Copy this file to .env.local and fill in the values for your environment.
# Never commit real keys. Only VITE_* variables are exposed to the browser bundle.

# Price API (monorepo/price_api). Defaults to http://localhost:8000 when unset.
VITE_PRICE_API_URL=http://localhost:8000

# Firebase web app config (Firebase console > Project settings > Your apps).
# These are public client identifiers, but keep them out of git and use per-environment values.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Set to true only when running the Firebase emulator locally.
VITE_USE_FIREBASE_EMULATOR=false

# Web push (Firebase Cloud Messaging) VAPID public key.
VITE_FCM_VAPID_KEY=your-vapid-public-key

# Supabase (storage only). Use the project URL and the anon public key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Firebase Realtime Database URL used for presence (optional).
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Client-side mock switches for local development. Keep false in production.
VITE_MPESA_MOCK_MODE=false
VITE_AIRTEL_MOCK_MODE=false
VITE_STRIPE_MOCK_MODE=false

# Key used by the finance data-protection helper. Set a long random value per environment.
VITE_DATA_PROTECTION_KEY=replace-with-a-long-random-string
